# Frontend Supabase keys (Vite exposes VITE_* vars to browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets (NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_INVITE_CODE=TF-ADMIN-2026
AUTH_HMAC_SECRET=change-this-in-production-to-a-long-random-secret
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:4000
PORT=4000
